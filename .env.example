# Google Drive Picker API integration (Client-side only)
# Get credentials at https://console.cloud.google.com/
# 1. Enable Google Picker API + Google Drive API
# 2. Add OAuth 2.0 Web Client ID with authorized JS origins (e.g. http://localhost:3000, https://aimetadataeraser.com)
# 3. Add API Key restricted to HTTP referrers
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
